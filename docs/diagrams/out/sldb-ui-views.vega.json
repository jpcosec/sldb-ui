          "fields": [
            "index",
            "index"
          ],
          "ops": [
            "min",
            "max"
          ],
          "as": [
            "minIdx",
            "maxIdx"
          ]
        }
      ]
    },
    {
      "name": "viewBoundaries",
      "source": "views",
      "transform": [
        {
          "type": "formula",
          "expr": "[datum.minIdx, datum.maxIdx + 1]",
          "as": "indices"
        },
        {
          "type": "flatten",
          "fields": [
            "indices"
          ]
        },
        {
          "type": "aggregate",
          "groupby": [
            "indices"
          ]
        }
      ]
