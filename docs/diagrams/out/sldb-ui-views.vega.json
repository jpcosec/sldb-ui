  "scales": [
    {
      "name": "kindColor",
      "type": "ordinal",
      "domain": [
        "service",
        "ui",
        "boundary",
        "core"
      ],
      "range": [
        "#94A3B8",
        "#94A3B8",
        "#60A5FA",
        "#F59E0B"
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "from": {
        "data": "views"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "left + (datum.minIdx + datum.maxIdx + 1) * cellWidth / 2"
          },
          "y": {
            "value": 15
          },
          "text": {
            "field": "view"
          },
          "align": {
            "value": "center"
          },
          "fontWeight": {
            "value": "bold"
          },
          "fontSize": {
            "value": 15
          },
          "fill": {
            "value": "#475569"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "stages"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "left + datum.index * cellWidth + cellWidth / 2"
          },
          "y": {
            "value": 40
          },
          "text": {
            "field": "label"
          },
          "align": {
            "value": "center"
          },
          "fontWeight": {
            "value": "bold"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#475569"
          }
        }
      }
    },
    {
      "type": "rule",
      "from": {
        "data": "stageBoundaries"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "left + datum.index * cellWidth"
          },
          "y": {
            "signal": "top - 20"
          },
          "y2": {
            "signal": "top + 14 * rowHeight + 10"
          },
          "stroke": {
            "value": "#CBD5E1"
          },
          "strokeDash": {
            "value": [
              4,
              4
            ]
          }
        }
      }
    },
    {
      "type": "rule",
      "from": {
        "data": "viewBoundaries"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "left + datum.indices * cellWidth"
          },
          "y": {
            "signal": "top - 40"
          },
          "y2": {
            "signal": "top + 14 * rowHeight + 20"
          },
          "stroke": {
            "value": "#475569"
          },
          "strokeWidth": {
            "value": 2.5
          },
          "strokeOpacity": {
            "value": 0.6
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "rows"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 0
          },
          "x2": {
            "signal": "width"
          },
          "y": {
            "signal": "top + datum.row * rowHeight"
          },
          "height": {
            "signal": "rowHeight"
          },
          "fill": {
            "signal": "datum.depth === 0 ? (datum.row % 2 === 0 ? '#475569' : '#94A3B8') : (datum.row % 2 === 0 ? '#CBD5E1' : '#E2E8F0')"
          },
          "fillOpacity": {
            "value": 0.15
          }
        }
      }
    },
    {
      "type": "rule",
      "from": {
        "data": "rows"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "12 + datum.depth * 18"
          },
          "x2": {
            "signal": "12 + datum.depth * 18"
          },
          "y": {
            "signal": "top + datum.row * rowHeight + 2"
          },
          "y2": {
            "signal": "top + datum.row * rowHeight + rowHeight - 2"
          },
          "stroke": {
            "signal": "datum.depth === 0 ? '#475569' : '#94A3B8'"
          },
          "strokeWidth": {
            "signal": "datum.depth === 0 ? 3 : 1.5"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "rows"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "20 + datum.depth * 18"
          },
          "y": {
            "signal": "top + datum.row * rowHeight + rowHeight / 2"
          },
          "text": {
            "field": "label"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#111827"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "spans"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "left + datum.start * cellWidth + 4"
          },
          "x2": {
            "signal": "left + datum.end * cellWidth - 4"
          },
          "y": {
            "signal": "top + datum.row * rowHeight + barPadding"
          },
          "height": {
            "signal": "rowHeight - barPadding * 2"
          },
          "cornerRadius": {
            "value": 7
          },
          "fill": {
            "scale": "kindColor",
            "field": "kind"
          },
          "fillOpacity": {
            "signal": "max(0.3, 1 - (datum.depth * 0.25))"
          },
          "stroke": {
            "scale": "kindColor",
            "field": "kind"
          },
          "strokeOpacity": {
            "value": 0.7
          },
          "strokeWidth": {
            "value": 1.5
          }
        }
      }
    }
  ]
}